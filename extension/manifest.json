{
  "manifest_version": 3,
  "name": "SoundBar Tabs",
  "version": "0.2.1",
  "description": "Per-tab volume, mute and pause. Lower YouTube without touching your Meet call.",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  },
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SoundBar Tabs"
  },
  "icons": {
    "128": "icon128.png"
  }
}
